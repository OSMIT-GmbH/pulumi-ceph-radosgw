{
  "name": "ceph-radosgw",
  "displayName": "Ceph Rados Gateway",
  "description": "A Pulumi provider for managing Ceph Rados Gateway resources.",
  "homepage": "https://github.com/OSMIT-GmbH/pulumi-ceph-radosgw",
  "repository": "https://github.com/OSMIT-GmbH/pulumi-ceph-radosgw",
  "namespace": "osmit-gmbh",
  "language": {
    "csharp": {
      "respectSchemaVersion": true
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/OSMIT-GmbH/pulumi-ceph-radosgw/sdk/go/pulumi-ceph-radosgw",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "respectSchemaVersion": true
    },
    "python": {
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {
    "variables": {
      "itsasecret": {
        "type": "boolean"
      }
    }
  },
  "provider": {
    "properties": {
      "itsasecret": {
        "type": "boolean"
      }
    },
    "inputProperties": {
      "itsasecret": {
        "type": "boolean"
      }
    }
  },
  "resources": {
    "ceph-radosgw:index:Random": {
      "properties": {
        "length": {
          "type": "integer"
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "length",
        "result"
      ],
      "inputProperties": {
        "length": {
          "type": "integer"
        }
      },
      "requiredInputs": [
        "length"
      ]
    },
    "ceph-radosgw:index:RandomComponent": {
      "properties": {
        "length": {
          "type": "integer"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "length",
        "password"
      ],
      "inputProperties": {
        "length": {
          "type": "integer"
        }
      },
      "requiredInputs": [
        "length"
      ],
      "isComponent": true
    }
  }
}
